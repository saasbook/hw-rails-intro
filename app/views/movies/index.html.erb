<h1>Movies</h1>

<%#  Part 2: Start here... %>

<div id="movies">
  <% @movies.each do |movie| %>
    <%= render movie %>
    <p>
      <%= link_to "Show this movie", movie, class: 'btn btn-primary btn-sm' %>
    </p>
  <% end %>
</div>

<%= link_to "New movie", new_movie_path %>
